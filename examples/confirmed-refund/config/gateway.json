{
 "listen": "127.0.0.1:8444",
 "dev_local_only": true,
 "tls": {
  "mode": "dev_self_signed",
  "cert_out": "/run/gw-tls/gateway-dev-cert.pem"
 },
 "app_origin": "https://app.localhost:8443",
 "auth_origin": "https://auth.localhost:8443",
 "upstream": {
  "unix": "/run/app-http/nginx.sock"
 },
 "app_wid": "spiffe://nodkey.demo/workload/shop",
 "read_routes": [
  {
   "path": "/orders",
   "rop": [
    "payments.get_order"
   ]
  },
  {
   "path": "/orders/",
   "rop": [
    "payments.get_order"
   ]
  }
 ],
 "app_cookies": [
  "shop_customer",
  "shop_last_pid"
 ],
 "broker_socket": "/run/nodkey/gw-broker/broker.sock",
 "authority_socket": "/run/nodkey/gw-authority/authority.sock",
 "expected_broker_uid": 10002,
 "expected_authority_uid": 10004,
 "session": {
  "absolute_lifetime_s": 3600,
  "idle_timeout_s": 1800
 },
 "limits": {
  "max_request_body": 262144,
  "max_response_body": 1048576,
  "upstream_timeout_ms": 15000,
  "ipc_timeout_ms": 5000,
  "approve_timeout_ms": 8000,
  "max_store_entries": 10000,
  "preauth_per_client": 8,
  "request_body_timeout_ms": 15000,
  "response_write_timeout_ms": 10000,
  "unrouted_connections": 128,
  "app_connections": 256,
  "auth_connections": 64
 },
